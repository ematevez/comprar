# ============================================
# .env.example — Plantilla de configuración
# Copiar a .env y completar con datos reales:
#   cp .env.example .env
# ¡NUNCA subir .env a Git ni incluirlo en la imagen Docker!
# ============================================

# ===== CREDENCIALES COMPRAR.GOB.AR =====
CUIT=
PASSWORD=

# ===== CONFIGURACIÓN DE EJECUCIÓN =====
INTERVALO_HORAS=24
TIMEOUT_INACTIVIDAD=60
NOMBRE_EXCEL=procesos_armada.xlsx

# ===== EMAIL - Reporte diario =====
# Gmail: usar "App Password" (no tu password normal)
# Ir a: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Separar múltiples emails con coma
EMAIL_TO=
# Hora del reporte diario (0-23)
EMAIL_REPORT_HOUR=20

# ===== TELEGRAM BOT =====
# Obtener token de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# Obtener chat ID enviando /start al bot y luego visitando:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_IDS=

# ===== SEGURIDAD =====
ADMIN_USER=admin
ADMIN_PASS=
SECRET_KEY=
# IPs permitidas (vacío = todas)
ALLOWED_IPS=
# Puerto del servidor
PUERTO=8765

# ===== LICENCIA (para Docker / servidores) =====
# La licencia se ata a la MAC de la máquina; en Docker la MAC cambia con
# cada contenedor y el dashboard queda bloqueado. Si ponés acá la clave de
# renovación, el servidor la usa para auto-renovarse al detectar otra MAC.
# Vacío = comportamiento original (pantalla de licencia manual).
LICENCIA_TOKEN=
